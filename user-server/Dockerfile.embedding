# ============================================================
# Embedding Server Dockerfile（轻量版，2026-07-16）
# - 仅运行 embedding-server（纯 Go），无需 Chromium/PostgreSQL
# - 多阶段构建，镜像小、启动快（~15s vs 之前 120s）
# - 协议：OpenAI 兼容 /v1/embeddings（与 TEI 行为一致）
# - 算法：字符 n-gram TF-IDF + 随机投影（详见 internal/embedding/local）
# ============================================================

# 阶段 1: 构建
FROM golang:1.25-alpine AS builder

WORKDIR /app

# 国内代理
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0
ENV GOOS=linux

RUN apk update && apk add --no-cache git gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -ldflags="-s -w" -trimpath -o /out/embedding-server ./cmd/embedding-server/main.go

# 阶段 2: 运行时（极简 alpine）
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata wget

ENV TZ=Asia/Shanghai
ENV EMBEDDING_PORT=80
ENV EMBEDDING_DIM=768
ENV EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5

WORKDIR /app

COPY --from=builder /out/embedding-server /app/embedding-server

RUN chmod +x /app/embedding-server

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=10s \
  CMD wget -q -O - http://127.0.0.1:80/health || exit 1

# 默认参数：监听 80 端口、768 维、BGE 模型名（可由环境变量覆盖）
ENTRYPOINT ["/app/embedding-server"]
CMD ["--port=80", "--dim=768", "--model=BAAI/bge-base-zh-v1.5"]
