# 生产环境配置
# =============================================================
# 单一源约束（端口/URL 默认值）
# 单一代码源：hivemtk/user-server/internal/config/ports.go
# 单一文档源：hivemtk/user-server/docs/dev/DEVELOPMENT.md §2.4 端口对照表
# 跨包对齐：
#   - user-server DefaultUserServerBaseURL="http://localhost:8204"
# =============================================================
NODE_ENV=production

# API 基础地址（线上 prod 模式：前端 hiveuser.xapptool.cn ↔ API hiveuserapi.xapptool.cn 跨域，必须用绝对地址）
# 局域网 prod 发行包构建时通过 --build-arg VITE_API_BASE_URL=/ 覆盖为同源相对路径
# v3 修复：同源相对路径——hiveuser 域名 反向代理层 已代理 /api 到后端，
# 彻底消除跨域(CORS)依赖；如需跨域部署请自行改回绝对地址并配置 CORS
VITE_API_BASE_URL=/

# 是否开启 mock
VITE_USE_MOCK=false