# ============================================================
# user-web（商户端）环境变量示例
# 复制为 .env.development（本地开发）或 .env.production（生产构建）
# ============================================================

# 运行环境
NODE_ENV=development

# API 服务地址（可配置，关键项）
# 留空或 / 表示同源相对路径，由 vite(本地)/ nginx(生产) 代理 /api 转发到后端 user-server（本地 8204）
# 跨域 / 远程独立部署时改为绝对地址，例如：
#   VITE_API_BASE_URL=https://user-api.your-domain.com
VITE_API_BASE_URL=/

# 是否开启 mock 数据（本地联调后端未就绪时可用）
VITE_USE_MOCK=false
