# ============================================================
# scripts/inference-host/models.env —— dev / prod 模型定义
# ------------------------------------------------------------
# 设计：
#   - 通过 HIVEMTK_PROFILE=dev|prod 选择档位
#   - 允许在 source 前用同名环境变量覆盖任意字段
#   - 仓库 ID 与文件名一一对应 ModelScope 上的真实路径
#   - 用户可自由替换为适配机器的版本（保持 embedding 1024 维）
# ============================================================

# 通用设置
if [[ -z "${HIVEMTK_PROFILE:-}" ]]; then
  export HIVEMTK_PROFILE=dev
fi

# ------------------------------------------------------------
# dev 档（中量，3G+2.5G+1G ≈ 6.5G 总内存）
# 2026-07-26 调整：1.5B→3B。3B q4 在 8 核 CPU 上单次推理 30-180s,
# 回复质量优于 1.5B。如内存紧张(8G 以下)可手动切回 1.5B。
# 如需更高回复质量，切 prod 档（14B，需 32GB+ 内存）。
# ------------------------------------------------------------
if [[ "$HIVEMTK_PROFILE" == "dev" ]]; then
  # LLM
  : "${LLM_REPO:=Qwen/Qwen2.5-7B-Instruct-GGUF}"
  : "${LLM_FILE:=qwen2.5-7b-instruct-q4_k_m.gguf}"
  : "${LLM_SERVED_NAME:=qwen2.5-3b-instruct}"
  # 8 核 16G 内存下 3 个模型 + KV cache 内存紧张，
  # 4096 对客服对话足够（system prompt + 多轮历史 < 3K token）。
  : "${LLM_CTX_SIZE:=4096}"

  # Embedding（必须 1024 维，bge-m3 满足）
  : "${EMBEDDING_REPO:=Xorbits/bge-m3-gguf}"
  : "${EMBEDDING_FILE:=bge-m3-Q4_K_M.gguf}"  # ModelScope 实际文件名是大写 Q4_K_M
  : "${EMBEDDING_SERVED_NAME:=bge-m3}"
  : "${EMBEDDING_DIM:=1024}"
  : "${EMBEDDING_CTX_SIZE:=8192}"

  # Rerank（用户参考：gaoshengwinner/bge-reranker-v2-m3-Q4_K_M-GGUF on ModelScope）
  # 实际使用 puppyM 仓库（HF/hf-mirror 可达，文件名无空格；ModelScope 无此仓库会 404 快速跳过）
  : "${RERANK_REPO:=puppyM/bge-reranker-v2-m3-Q4_K_M-GGUF}"
  : "${RERANK_FILE:=bge-reranker-v2-m3-q4_k_m.gguf}"
  : "${RERANK_SERVED_NAME:=bge-reranker-v2-m3}"
  : "${RERANK_CTX_SIZE:=2048}"
fi

# ------------------------------------------------------------
# prod 档（高性能，10G+4.5G+1.6G ≈ 16G 总内存；推荐 8C16G+）
# ------------------------------------------------------------
if [[ "$HIVEMTK_PROFILE" == "prod" ]]; then
  # LLM
  : "${LLM_REPO:=Qwen/Qwen2.5-14B-Instruct-GGUF}"
  : "${LLM_FILE:=qwen2.5-14b-instruct-q4_k_m.gguf}"
  : "${LLM_SERVED_NAME:=qwen2.5-14b-instruct}"
  : "${LLM_CTX_SIZE:=8192}"

  # Embedding（保持 1024 维）
  : "${EMBEDDING_REPO:=Xorbits/bge-m3-gguf}"
  : "${EMBEDDING_FILE:=bge-m3-F16.gguf}"     # prod 用 F16 提升召回
  : "${EMBEDDING_SERVED_NAME:=bge-m3}"
  : "${EMBEDDING_DIM:=1024}"
  : "${EMBEDDING_CTX_SIZE:=8192}"

  # Rerank
  : "${RERANK_REPO:=puppyM/bge-reranker-v2-m3-Q4_K_M-GGUF}"
  : "${RERANK_FILE:=bge-reranker-v2-m3-q4_k_m.gguf}"
  : "${RERANK_SERVED_NAME:=bge-reranker-v2-m3}"
  : "${RERANK_CTX_SIZE:=2048}"
fi

# 导出供下游使用
export HIVEMTK_PROFILE
export LLM_REPO LLM_FILE LLM_SERVED_NAME LLM_CTX_SIZE
export EMBEDDING_REPO EMBEDDING_FILE EMBEDDING_SERVED_NAME EMBEDDING_DIM EMBEDDING_CTX_SIZE
export RERANK_REPO RERANK_FILE RERANK_SERVED_NAME RERANK_CTX_SIZE

# 仅在直接执行本文件时打印
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  echo "HIVEMTK_PROFILE=$HIVEMTK_PROFILE"
  echo "  LLM       : $LLM_REPO / $LLM_FILE"
  echo "  Embedding : $EMBEDDING_REPO / $EMBEDDING_FILE  (dim=$EMBEDDING_DIM)"
  echo "  Rerank    : $RERANK_REPO / $RERANK_FILE"
fi
