# ============================================================
# HiveMtk 用户端 - 环境变量示例（2026-07-24 宿主机 llama.cpp 部署）
# ------------------------------------------------------------
# 复制为 .env 后修改默认值。
#
# 部署定位（2026-07-24 重构）：
#   - 数据层（PG/Redis）通过 docker-compose-host.yml 启动，端口绑 127.0.0.1
#   - 推理层（llm/embedding/rerank）走宿主机 llama.cpp（scripts/inference-host/）
#   - user-server / user-web 都在宿主机跑（user-server 用 air 热更新）
#   - 平台端（hivemtk-platform）与本用户端物理隔离，通过 PLATFORM_API_URL 跨网络调用
#
# 所有配置可由部署环境变量覆盖（user-server 启动时自动读取）；
# .env 文件由 make install / docker compose env_file 自动注入到容器。
# ============================================================

# ==================== 镜像标签（保留兼容字段）====================
TAG=latest

# ==================== PostgreSQL（宿主机部署）====================
# 通过 docker-compose-host.yml 启动 mtk-postgres 容器，端口 127.0.0.1:8202
POSTGRES_USER=admin
POSTGRES_PASSWORD=ChangeMe_To_Strong_Password_123!

USER_DB_NAME=user_db
# 宿主机端口：容器内 8202 → 宿主机 8202（绑 127.0.0.1）
USER_POSTGRES_HOST_PORT=8202

# ==================== Redis（宿主机部署）====================
REDIS_HOST_PORT=8203
REDIS_PASSWORD=ChangeMe_To_Strong_RedisPass_789!

# ==================== 应用端口 ====================
# user-server 宿主机直接监听（air 启动时）
USER_SERVER_PORT=8204

# ==================== JWT / 安全密钥 ====================
JWT_SECRET=ChangeMe_To_32Char_Random_JWT_Secret_Key_For_Production
JWT_EXPIRE=24h
PLATFORM_LICENSE_SECRET=ChangeMe_To_32Char_Platform_License_Shared_Secret
PLATFORM_ADMIN_PASSWORD=ChangeMe_To_Strong_Password_For_User_Admin

# ==================== 平台 API URL（用户端调用平台端）====================
# 同机部署：http://host.docker.internal:8205（旧 docker-compose 用）
# 新宿主机部署：user-server 跑在宿主机，平台端可能也在宿主机或独立机器
#   - 同机：http://127.0.0.1:8205
#   - 跨机：https://api.example.com
# 注意：user-server(internal/config/platform.go) 实际读取 PLATFORM_API_HOST，不是 PLATFORM_API_URL
PLATFORM_API_HOST=http://127.0.0.1:8205

# ==================== 应用模式 ====================
GIN_MODE=release

# ==================== CORS 跨域配置 ====================
CORS_ALLOW_ORIGINS_USER=https://user.example.com

# ==================== 七牛云存储 ====================
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# ==================== 邮箱配置 ====================
QQ_NUMBER=
QQ_EMAIL=
QQ_EMAIL_PASSWORD=
EMAIL_163_USER=
EMAIL_163_PASSWORD=
EMAIL_163_SMTP_HOST=smtp.163.com

# =============================================================================
# 宿主机 llama.cpp 推理栈（2026-07-24 重构）
# -----------------------------------------------------------------------------
# 三个能力全部由宿主机 llama-server 提供，OpenAI 兼容：
#   - LLM       : /v1/chat/completions   (port 8207)
#   - Embedding : /v1/embeddings         (port 8208)
#   - Rerank    : /v1/rerank             (port 8209)
# 数据层：PG 127.0.0.1:8202 / Redis 127.0.0.1:8203（docker compose）
#
# 启动顺序：bash scripts/inference-host/install-llama-cpp.sh → download-models.sh
#           → start-all.sh → warmup.sh → smoke-test.sh
# 推荐入口：make install (一键全流程) / make dev-all (启动数据+推理)
# =============================================================================

# ---- 宿主机路径 ----
# 模型根目录：默认保存在本项目 hivemtk/models/ 下（.gitignore 已忽略大文件）
# 目录结构：$HIVEMTK_MODELS_DIR/{llm,embedding,rerank}/<file>.gguf
# 生产部署可指向独立数据盘：HIVEMTK_MODELS_DIR=/data/hivemtk/models
# HIVEMTK_MODELS_DIR=./models
# 运行时目录：pid / log（运行时产物，默认在 $HOME/.hivemtk/runtime）
# HIVEMTK_RUNTIME_DIR=$HOME/.hivemtk/runtime

# ---- llama.cpp 二进制路径（自动探测，亦可手动指定）----
# macOS Apple Silicon: /opt/homebrew/bin/llama-server
# macOS Intel / Linux brew: /usr/local/bin/llama-server
# Linux apt: /usr/bin/llama-server
# LLAMACPP_BIN=llama-server

# ---- 模型 profile（dev | prod）----
# dev  : 轻量档，~6G 总内存（Qwen2.5-3B-Instruct + bge-m3 + bge-reranker-v2-m3，全 Q4_K_M）
# prod : 高性能档，~16G 总内存（Qwen2.5-14B-Instruct + bge-m3-f16 + bge-reranker-v2-m3-Q8_0）
HIVEMTK_PROFILE=dev

# ---- 模型下载源顺序（逗号分隔）----
# 默认 modelscope 国内优先；hf-mirror 是 HF 国内镜像；hf 走 HF 官方（需 HF_TOKEN）
DOWNLOAD_SOURCE=modelscope,hf-mirror,hf

# ---- user-server 调 llama-server 的地址（与 .air.toml / config.yaml 一致）----
# 这些地址由 user-server 进程读取，决定它去哪里请求 LLM/embedding/rerank
# 宿主机部署统一走 127.0.0.1（user-server 与 llama-server 同机）
LLM_BASE_URL=http://127.0.0.1:8207/v1
LLM_API_KEY=local
LLM_MODEL=Qwen2.5-3B-Instruct

EMBEDDING_BASE_URL=http://127.0.0.1:8208/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_ALLOW_FALLBACK=false

RERANK_BASE_URL=http://127.0.0.1:8209
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_ENABLED=true

# ---- 端口分配（一般无需修改）----
LLM_PORT=8207
EMBEDDING_PORT=8208
RERANK_PORT=8209

# ---- 推理参数（按需调优）----
CTX_SIZE=8192
THREADS=0
NGL=0
# macOS Apple Silicon Metal: NGL=999（GPU 全卸载）
# 纯 CPU: NGL=0
# NVIDIA GPU: NGL=999
BATCH_SIZE=512

# ==================== 日志 ====================
LOG_LEVEL=info
