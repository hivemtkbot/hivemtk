# ============================================================
# HivemTK 用户端 - 环境变量示例（复制为 .env 后修改默认值）
#
# 部署说明（2026-07-21 重构）：
#   - 本文件用于【用户端】独立部署，与【平台端】物理隔离。
#   - 平台端地址 PLATFORM_API_URL：同机部署用 host.docker.internal:8205；
#     跨机/生产改为平台端公网域名，如 https://api.example.com
#   - 前端（user-web）与嵌入 SDK（embed-sdk）在【宿主机】构建后挂载。
#   - 本地推理栈（mtk-llm / mtk-embedding / mtk-rerank）的环境变量也集中在
#     本文件，dev / prod 仅模型档位不同，默认给出 prod 档，dev 档见注释。
# ============================================================

# ==================== 镜像标签 ====================
TAG=latest

# ==================== PostgreSQL ====================
POSTGRES_USER=admin
POSTGRES_PASSWORD=ChangeMe_To_Strong_Password_123!

# 数据库名（默认值，通常不需要修改）
USER_DB_NAME=user_db

# PG 宿主机映射端口
USER_POSTGRES_HOST_PORT=8202

# ==================== Redis ====================
REDIS_HOST_PORT=8203
REDIS_PASSWORD=ChangeMe_To_Strong_RedisPass_789!

# ==================== 应用端口（映射到宿主机）====================
USER_SERVER_PORT=8204

# ==================== JWT / 安全密钥 ====================
# 私域合规基线 §7.2：禁止明文落库，由部署环境注入
JWT_SECRET=ChangeMe_To_32Char_Random_JWT_Secret_Key_For_Production
JWT_EXPIRE=24h
PLATFORM_LICENSE_SECRET=ChangeMe_To_32Char_Platform_License_Shared_Secret
ADMIN_PASSWORD=ChangeMe_To_Strong_Password_For_User_Admin

# ==================== 平台 API URL（用户端调用平台端）====================
# 同机部署：host.docker.internal 经 extra_hosts 映射到宿主机网关
# 跨机/生产：改为平台端公网域名
PLATFORM_API_URL=http://host.docker.internal:8205

# ==================== 应用模式 ====================
GIN_MODE=release

# ==================== CORS 跨域配置 ====================
# 用户端 API 允许的前端域名
CORS_ALLOW_ORIGINS_USER=https://user.example.com

# ==================== 七牛云存储 ====================
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# ==================== 邮箱配置 ====================
# QQ 邮箱（平台通知）
QQ_NUMBER=
QQ_EMAIL=
QQ_EMAIL_PASSWORD=

# 163 邮箱（邮件营销）
EMAIL_163_USER=
EMAIL_163_PASSWORD=
EMAIL_163_SMTP_HOST=smtp.163.com

# ==================== LLM ====================
# 本地：LLM_BASE_URL=http://mtk-llm:8207/v1 / LLM_API_KEY=local
# 云端：LLM_BASE_URL=https://api.deepseek.com/v1 / LLM_API_KEY=sk-xxx
LLM_API_KEY=local
LLM_BASE_URL=http://mtk-llm:8207/v1
LLM_MODEL=Qwen2.5-14B-Instruct

# ==================== 日志 ====================
LOG_LEVEL=info

# =============================================================================
# 本地推理服务（mtk-*，私域部署基线）
# -----------------------------------------------------------------------------
# 私域部署基线：embedding 与 rerank 均在本地 TEI 容器内完成，数据禁止出域。
#   - mtk-embedding: BAAI/bge-m3（向量化，1024 维，OpenAI 兼容 /v1/embeddings），端口 8208
#   - mtk-rerank:    BAAI/bge-reranker-v2-m3（重排，OpenAI 兼容 /v1/rerank），端口 8209
#   - mtk-llm:       llama.cpp（Qwen2.5，OpenAI 兼容 /v1/chat/completions），端口 8207
# 模型预下载至 ./models/ 目录，docker-compose.yml 通过卷挂载到容器。
#
# 档位说明（二者仅模型不同，默认 prod 档）：
#   prod 重量档（生产服务器）：Qwen2.5-14B-Instruct + bge-m3
#   dev  轻量档（个人电脑）：Qwen2.5-3B-Instruct + Qwen3-Embedding-0.6B
# 切换到 dev 档：将下方 prod 值替换为对应注释块中的 dev 值即可。
# =============================================================================

# —— LLM（默认 prod: Qwen2.5-14B-Instruct, Q4）——
LLM_MODEL_REPO=Qwen/Qwen2.5-14B-Instruct-GGUF
LLM_MODEL_FILE=qwen2.5-14b-instruct-q4_k_m.gguf
LLM_MODEL_NAME=Qwen2.5-14B-Instruct
LLM_DOWNLOAD_SOURCE=modelscope,hf-mirror,hf

# dev 轻量档（取消注释并覆盖上面的 LLM_* 三个值）：
# LLM_MODEL_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
# LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# LLM_MODEL_NAME=Qwen2.5-3B-Instruct

# —— Embedding（默认 prod: bge-m3, 1024 维）——
EMBEDDING_MODEL_ID=/data/bge-m3
EMBEDDING_SERVED_NAME=bge-m3

# dev 轻量档（取消注释并覆盖上面的 EMBEDDING_* 两个值）：
# EMBEDDING_MODEL_ID=/data/Qwen3-Embedding-0.6B
# EMBEDDING_SERVED_NAME=Qwen3-Embedding-0.6B

# —— Rerank（bge-reranker-v2-m3）——
RERANK_MODEL_ID=/data/bge-reranker-v2-m3
RERANK_SERVED_NAME=bge-reranker-v2-m3

# ==================== 业务侧推理接入（联网地址，通常无需修改）====================
# 这些为 user-server 连接本地推理栈的地址，与上面模型档位无关。
EMBEDDING_BASE_URL=http://mtk-embedding:8208/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
# 离线/单测场景：设为 true 允许回退到 hash 伪向量（仅单测，生产必须 false）
EMBEDDING_ALLOW_FALLBACK=false

# Rerank 重排
RERANK_BASE_URL=http://mtk-rerank:8209
RERANK_API_KEY=
RERANK_ENABLED=true
